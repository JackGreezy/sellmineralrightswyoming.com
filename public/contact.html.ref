#onetrust-banner-sdk.ot-bnr-w-logo .ot-bnr-logo {
    height: auto;
    width: auto;
}


#onetrust-consent-sdk{
    font-family: 'Inter', sans-serif !important;
}

#onetrust-accept-btn-handler:hover {
  background-color: #030F77 !important;
}

#onetrust-accept-btn-handler:active {
  background-color: #020B59 !important;
}

#CookieSettingsButton {
   font-size: 10px !important;
}

#CookieSettingsButton:hover {
   color: #0816A1 !important;
}

#onetrust-banner-sdk .has-reject-all-button .banner-actions-container {
   width: auto !important;
    max-width: 100%;
}

.banner-actions-container #onetrust-reject-all-handler {
    height: 42px !important;
    background-color: #FBFDFE !important;
    color: #0816A1 !important ;
    text-decoration: none!important;
    font-size: 10px !important;
    border-color: #0816A1 !important;
    border-top-right-radius: 10px !important;
    border-bottom-left-radius: 10px !important;
}

.banner-actions-container #onetrust-reject-all-handler:hover {
    background-color: #FBFDFE !important;
    color: #0816A1 !important;
    box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25) !important;
    border: transparent !important;

}

#onetrust-banner-sdk #onetrust-button-group {
    text-align: center;
    display: flex;
    width: 100%;
    justify-content: space-between;
    flex-direction: row-reverse;
}
#onetrust-policy-title  img {
    height: auto !important;
    width:150px;
  }

/* CTA Primaire 2 */
#onetrust-accept-btn-handler {
    height: 42px !important;
    border-top-right-radius: 10px !important;
    border-bottom-left-radius: 10px !important;
}

/* Hover CTA Primaire 2 */
#onetrust-accept-btn-handler:hover {
    background-color: #FBFDFE !important;
    color: #0816A1 !important;
    box-shadow: 0px 4px 4px 0px rgba(0, 0, 0, 0.25) !important;
    border: transparent !important;
}

